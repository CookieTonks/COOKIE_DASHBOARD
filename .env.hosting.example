# Plantilla del .env para el hosting. Cópiala como .env en la carpeta de la app en el servidor
# y llena lo que está vacío. Nunca subas el .env al repositorio.

APP_NAME=CookieCodes
APP_ENV=production
# En tu máquina corre: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Mexico_City
APP_URL=https://dashboard.pagos.cookiecodes.com.mx

APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cokiecod_dashboard_pagos
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Solo para crear tu usuario con el cron de instalación. BÓRRALA en cuanto entres.
ADMIN_PASSWORD=""

# Empieza en log: no sale ningún correo. Cámbialo a smtp cuando quieras enviar de verdad.
MAIL_MAILER=log
MAIL_HOST=mail.cookiecodes.com.mx
MAIL_PORT=587
MAIL_USERNAME="reminders@cookiecodes.com.mx"
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="reminders@cookiecodes.com.mx"
MAIL_FROM_NAME="${APP_NAME}"

REMINDER_BUSINESS_DAYS_BEFORE=2
# Tu correo personal, para recibir una copia oculta de cada recordatorio.
REMINDER_BCC=
